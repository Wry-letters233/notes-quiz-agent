# Choose your LLM provider for generating answers/quizzes:
#   ollama  -> free, fully local, no API key needed (default, recommended)
#   openai  -> hosted, needs a paid API key, but slightly higher quality
LLM_PROVIDER=ollama

# --- Only used if LLM_PROVIDER=ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Only used if LLM_PROVIDER=openai ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Note: embeddings are ALWAYS local (sentence-transformers) regardless of
# the LLM_PROVIDER setting above — no key needed for that part, ever.
